# ─────────────────────────────────────────────────────────────────────────────
# Financial Data Chat Assistant — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (gitignored).
# Every variable below is derived from docs/ — see the reference tag on each.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / runtime (NFR-013) ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000                              # NestJS backend port (architecture §7)

# ── PostgreSQL — application user (architecture §7 docker-compose) ────────────
# The app connects as this user for users/conversations/messages/audit_logs.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=financial_db
DATABASE_POOL_SIZE=10                   # TypeORM pg pool max (GAP-013)

# ── PostgreSQL — llm_reader user (prompt_spec Layer 3, CLAUDE.md §2/§3) ───────
# SELECT-only role that executes LLM-generated SQL. Separate creds from the app
# user by design (defense-in-depth). Same host/port/db as above.
LLM_READER_USER=llm_reader
LLM_READER_PASSWORD=change_me_llm_reader

# ── Redis — cache, usage tracking, refresh-token store (erd.md, NFR-005) ──────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── OpenAI (tech_stack.md, CR-014, CLAUDE.md §3) ─────────────────────────────
# Use gpt-4o-mini during dev to save budget; switch to gpt-4o for final build.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ── JWT — access token, in memory on client (architecture §3, CR-016) ────────
JWT_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES=15m                 # short-lived access token (~15 min)

# ── JWT — refresh token, httpOnly cookie + Redis rotation (erd.md, CR-016) ───
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES=7d                 # long-lived refresh token
REFRESH_TOKEN_TTL=604800               # Redis key TTL in seconds (7 days)

# ── Refresh cookie attributes (CLAUDE.md §2, GAP-009) ────────────────────────
# httpOnly + SameSite=Strict + Path=/api/auth/refresh are fixed by policy.
# COOKIE_SECURE=false is allowed ONLY for http://localhost dev; true in deploy.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_PATH=/api/auth/refresh

# ── Password hashing (CLAUDE.md §3, NFR-012) ─────────────────────────────────
BCRYPT_COST=12                         # cost factor >= 12

# ── Usage / spending limit (prompt_spec §5, FR-009/010/011, CR-015) ──────────
USAGE_LIMIT=1.0                        # default per-user spending cap (USD)
USAGE_RESET_INTERVAL=3600              # reset window in seconds (default 1h)

# ── Auth rate limiting (NFR-014, GAP-007) ────────────────────────────────────
THROTTLE_TTL=60                        # window in seconds
THROTTLE_LIMIT=10                      # max requests per window on auth routes

# ── CORS — explicit allowlist, credentials:true for refresh cookie (CR-017) ──
CORS_ORIGIN=http://localhost:5173

# ── Frontend (Vite) — backend API base URL ───────────────────────────────────
VITE_API_URL=http://localhost:3000
